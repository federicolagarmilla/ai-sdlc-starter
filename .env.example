# Road 3 (jira-rest skill): copy to .env and fill in. .env is never committed.
# Jira Cloud: API token from id.atlassian.com > Security > API tokens
JIRA_SITE=your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
# Jira Data Center instead: set JIRA_PAT (personal access token) and leave the two above empty
JIRA_PAT=
